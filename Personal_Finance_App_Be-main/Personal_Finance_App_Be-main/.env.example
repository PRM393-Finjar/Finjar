ASPNETCORE_ENVIRONMENT=Development
API_PORT=5284
API_CONTAINER_PORT=8080
APPLY_MIGRATIONS=true
ENABLE_SWAGGER=true

POSTGRES_DB=PersonalFinanceManagementDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432
# Canonical local DB container (docker compose): personal-finance-postgres
# Volume: personal_finance_app_be-main_personal-finance-postgres-data
# Do not start other local Postgres containers on port 5432.

JWT_SECRET_KEY=finjar-local-development-secret-key-change-me
JWT_ISSUER=PersonalFinanceManagement
JWT_AUDIENCE=PersonalFinanceManagement
JWT_EXPIRE_MINUTES=120

SEPAY_WEBHOOK_API_KEY=replace-with-sepay-webhook-key

# Gmail gửi OTP / mail chào mừng (App Password — không commit password thật)
# Dùng đúng tên key này (Docker Compose + dotnet run đều đọc được sau khi load .env)
MailOptions__Mail=uwu72909@gmail.com
MailOptions__DisplayName=Finjar
MailOptions__Host=smtp.gmail.com
MailOptions__Port=587
MailOptions__Password=xxxx xxxx xxxx xxxx
# OTP: cooldown 60s, max 5 sends / 60 phút. Không bật AllowLoggingSender trừ khi demo offline không SMTP.
# Email__OtpResendCooldownoldownSeconds=60
# Email__OtpMaxSendsPerWindow=5
# Email__OtpSendWindowMinutes=60
# Email__AllowLoggingSender=false

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Local OCR Vision service (required for Scan AI / imports/image)
# Start: cd ocr-service && pip install -r requirements.txt && python -m uvicorn main:app --host 0.0.0.0 --port 8000
# Ocr__BaseUrl=http://localhost:8000
# Ocr__Layout=invoice
# Ocr__TimeoutSeconds=120

